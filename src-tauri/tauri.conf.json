{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Market Glass",
  "version": "0.1.5",
  "identifier": "com.marketglass.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../apps/desktop-ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Market Glass",
        "url": "index.html?window=main",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["hudWindow", "mica", "acrylic"],
          "state": "followsWindowActiveState",
          "radius": 24
        },
        "shadow": true,
        "resizable": true
      },
      {
        "label": "mini",
        "title": "Market Glass Mini",
        "url": "index.html?window=mini",
        "width": 460,
        "height": 520,
        "minWidth": 460,
        "minHeight": 520,
        "maxWidth": 460,
        "maxHeight": 520,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["popover", "mica", "acrylic"],
          "state": "active",
          "radius": 22
        },
        "shadow": true,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": "default-src 'self' http://127.0.0.1:1420; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' http://127.0.0.1:1420; font-src 'self' data:; script-src 'self' http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDRjRFNkM2NTdENjk4MEYKUldRUG1OWlh4dWIwL0VXUzM0NTBOVUxjS2NLVTZnUWRoMG14azlOZnFUZjB3SDdKcjRscXVVUkgK",
      "endpoints": [
        "https://github.com/SunshineHub/market-glass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
